# Parametros do llama-server. Valores medidos neste hardware -- ver docs/benchmarks.md
LLM_MODEL=@MODELS_DIR@/qwen38-cyber/Qwen3.8-27B-Uncensored-Cyber-Q4_K_M.gguf
LLM_DRAFT=@MODELS_DIR@/qwen38-cyber/mtp-Qwen3.8-27B-Uncensored-Cyber-Q4_0.gguf
# n-max 2 foi o ponto otimo (+42,5%); acima de 3 a aceitacao do draft cai
SPEC_N_MAX=2
# NUNCA deixe no padrao: o modelo declara 262144 e o servidor tenta alocar
# o KV cache inteiro -- 8 GiB de uma vez, e falha
LLM_CTX=32768
LLM_HOST=127.0.0.1
LLM_PORT=8090
