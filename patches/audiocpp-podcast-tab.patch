new file mode 100644
index 0000000..2fef088
--- /dev/null
+++ b/webui/native/src/lib/Podcast.svelte
@@ -0,0 +1,605 @@
+<script lang="ts">
+  import { chatComplete, speech, uploadWav } from '$lib/api';
+  import { concatenateAudioBlobsWithGaps } from '$lib/audio';
+  import type { Translator } from '$lib/i18n';
+
+  export let tr: Translator = (key, _values, fallback = key) => fallback;
+
+  // Two-host podcast, NotebookLM "Deep Dive" style: paste or upload a document,
+  // an LLM (llama-server, proxied at /llm/) drafts an alternating-speaker
+  // script, then OmniVoice (this server's own /v1/audio/speech) voices each
+  // line and the browser stitches the result into one downloadable track.
+  // Everything runs client-side against the two model servers already
+  // exposed same-origin -- no extra backend service to deploy or keep running.
+  //
+  // Voice identity: OmniVoice's "voice design" (a free-text --instruct string)
+  // samples a NEW voice matching those attributes on every call -- a fixed
+  // seed does not pin identity across separate requests, confirmed by ear
+  // (an early version of this feature sounded like a different narrator on
+  // almost every line). The fix is to design each host's voice ONCE, from
+  // their first line, then CLONE that exact clip (voice_ref + reference_text)
+  // for every subsequent line by that host -- identity anchored in real audio
+  // instead of resampled from a description each time.
+
+  interface Turn { speaker: 'A' | 'B'; text: string; }
+  interface Script { title: string; turns: Turn[]; }
+  type StepStatus = 'idle' | 'script' | 'voice' | 'stitch' | 'done' | 'error';
+  type TurnStatus = 'queued' | 'voicing' | 'done';
+  interface HostAnchor { path: string; text: string; }
+
+  const PRESETS: Record<string, { label: string; instruct: string }> = {
+    hostA: { label: 'Host A', instruct: 'female, young adult, moderate pitch' },
+    hostB: { label: 'Host B', instruct: 'male, middle-aged, low pitch' }
+  };
+
+  // Recognized by OmniVoice's text tokenizer and rendered as actual
+  // paralinguistic sound, not spoken literally -- see tokenizer_text.cpp.
+  const NONVERBAL_TAGS = [
+    '[laughter]', '[sigh]', '[confirmation-en]', '[question-en]', '[question-ah]',
+    '[question-oh]', '[question-ei]', '[question-yi]', '[surprise-ah]', '[surprise-oh]',
+    '[surprise-wa]', '[surprise-yo]', '[dissatisfaction-hnn]'
+  ];
+
+  let docText = '';
+  let fileName = '';
+  let extracting = false;
+  let language = 'pt';
+  let turnCount = 10;
+  let speed = 0.92; // OmniVoice's default reads as noticeably fast for conversational pacing
+  let hostAInstruct = PRESETS.hostA.instruct;
+  let hostBInstruct = PRESETS.hostB.instruct;
+  let hostALabel = PRESETS.hostA.label;
+  let hostBLabel = PRESETS.hostB.label;
+  let hostAnchors: Record<'A' | 'B', HostAnchor | null> = { A: null, B: null };
+
+  let step: StepStatus = 'idle';
+  let statusText = '';
+  let errorText = '';
+  let script: Script | null = null;
+  let turnProgress = 0;
+  let turnStatuses: TurnStatus[] = [];
+  let finalAudioUrl = '';
+  let finalDurationSeconds = 0;
+  let aborted = false;
+
+  const MAX_DOC_CHARS = 12000; // keeps the script prompt well inside the 32k context
+
+  function resetOutput() {
+    script = null;
+    turnProgress = 0;
+    turnStatuses = [];
+    if (finalAudioUrl) URL.revokeObjectURL(finalAudioUrl);
+    finalAudioUrl = '';
+    finalDurationSeconds = 0;
+    errorText = '';
+    hostAnchors = { A: null, B: null }; // stale anchors would carry the previous run's voice
+  }
+
+  async function extractPdfText(file: File): Promise<string> {
+    // The server embeds ONLY dist/index.html (see CMakeLists.txt); anything
+    // Vite emits as a separate file -- which `new URL(worker, import.meta.url)`
+    // would -- is missing from the compiled binary. Importing the worker as a
+    // raw string keeps it inside the same inlined bundle as the rest of the app.
+    const pdfjs = await import('pdfjs-dist');
+    // @ts-expect-error -- Vite's `?raw` query has no ambient type declaration here
+    const workerSource = (await import('pdfjs-dist/build/pdf.worker.mjs?raw')).default as string;
+    pdfjs.GlobalWorkerOptions.workerSrc = URL.createObjectURL(
+      new Blob([workerSource], { type: 'application/javascript' })
+    );
+    const data = await file.arrayBuffer();
+    const doc = await pdfjs.getDocument({ data }).promise;
+    const pages: string[] = [];
+    for (let i = 1; i <= doc.numPages; i += 1) {
+      const page = await doc.getPage(i);
+      const content = await page.getTextContent();
+      pages.push(content.items.map((item) => ('str' in item ? item.str : '')).join(' '));
+    }
+    return pages.join('\n\n');
+  }
+
+  async function onFile(event: Event) {
+    const file = (event.target as HTMLInputElement).files?.[0];
+    if (!file) return;
+    fileName = file.name;
+    extracting = true;
+    errorText = '';
+    try {
+      const lower = file.name.toLowerCase();
+      docText = lower.endsWith('.pdf') ? await extractPdfText(file) : await file.text();
+    } catch (error) {
+      errorText = `Could not read ${file.name}: ${error instanceof Error ? error.message : error}`;
+      fileName = '';
+    } finally {
+      extracting = false;
+    }
+  }
+
+  function clearDoc() {
+    docText = '';
+    fileName = '';
+    resetOutput();
+  }
+
+  // OmniVoice's tokenizer matches these tags by an EXACT regex (see
+  // tokenizer_text.cpp); a close-but-wrong variant like "[laugh]" instead of
+  // "[laughter]" isn't a nonverbal sound at all -- it's spoken as literal,
+  // meaningless text. The prompt asks for exact strings, but LLMs still drift
+  // toward plausible synonyms often enough that this needs a hard backstop.
+  // A tag's suffix names the sound (question-EI, surprise-OH, ...), and the
+  // prompt explicitly forbids echoing it as a spoken word right after -- but
+  // this is a request the model drifts on, not a hard constraint (json_schema
+  // only enforces the JSON shape, never wording), so "[question-ei] Ei, ..."
+  // slips through often enough to need a backstop, not just a warning.
+  const ECHO_WORDS: Record<string, string[]> = {
+    '[question-ei]': ['ei'], '[question-ah]': ['ah'], '[question-oh]': ['oh'],
+    '[question-en]': ['en'], '[question-yi]': ['yi'],
+    '[surprise-ah]': ['ah'], '[surprise-oh]': ['oh'], '[surprise-wa]': ['wa', 'uau', 'nossa'],
+    '[surprise-yo]': ['yo'], '[confirmation-en]': ['en'],
+    '[dissatisfaction-hnn]': ['hnn', 'hmm'], '[laughter]': ['haha', 'kkk']
+  };
+
+  function escapeRegExp(value: string): string {
+    return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  }
+
+  function sanitizeNonverbalTags(text: string): string {
+    let cleaned = text.replace(/\[[a-z-]+\]/gi, (match) =>
+      NONVERBAL_TAGS.includes(match.toLowerCase()) ? match.toLowerCase() : '');
+    for (const [tag, echoes] of Object.entries(ECHO_WORDS)) {
+      // (?![\p{L}]) requires the echo to be a whole word, not a prefix of a
+      // longer one -- without it, "[confirmation-en] Então" matched "en" as
+      // a prefix of "Então" and mangled it into "tão" (\b alone doesn't help:
+      // JS's \w is ASCII-only, so "n|ã" already counts as a boundary).
+      const pattern = new RegExp(
+        `(${escapeRegExp(tag)})\\s*(?:${echoes.join('|')})(?![\\p{L}])[,.!?…]*\\s*`, 'iu'
+      );
+      cleaned = cleaned.replace(pattern, '$1 ');
+    }
+    return cleaned.replace(/[ \t]{2,}/g, ' ').replace(/^\s+|\s+$/g, '');
+  }
+
+  interface ChatMessage {
+    role: 'system' | 'user' | 'assistant' | 'tool';
+    content?: string;
+    tool_calls?: Array<{ id: string; type: 'function'; function: { name: string; arguments: string } }>;
+    tool_call_id?: string;
+  }
+
+  const WRITE_TURN_TOOL = {
+    type: 'function',
+    function: {
+      name: 'write_turn',
+      description: "Emits this host's next spoken line in the podcast.",
+      parameters: {
+        type: 'object',
+        properties: { text: { type: 'string' } },
+        required: ['text']
+      }
+    }
+  };
+
+  // Turn-by-turn generation via tool calling, one round-trip per line, instead
+  // of one big json_schema call for the whole script. A single call asked to
+  // plan N turns at once drifts by line 5-6: it reads as two narrators taking
+  // turns reporting facts, not people replying to each other, because the
+  // model is working from its own internal plan rather than the other host's
+  // ACTUAL committed words. Feeding back only the one tool call we keep (and
+  // discarding any extra calls the model volunteers in the same response --
+  // under tool_choice:"required" it will happily emit the whole episode in
+  // one burst if given the chance) forces every new line to be generated with
+  // the real prior line in context. Trades roughly 10x the round-trips (each
+  // with its own reasoning preamble) for materially better dialogue.
+  function systemPrompt(doc: string): string {
+    return `You are the co-writer for a podcast that discusses documents its audience sends in. `
+      + `Two hosts, A and B, riff on the document below like old friends catching up over coffee. `
+      + `This has to sound like two actual people thinking out loud, not a script -- real hosts `
+      + `almost never speak in tidy, evenly-sized sentences.\n\n`
+      + `This is the single most important rule: every line after the first must be a DIRECT REPLY `
+      + `to the specific thing the other host just said, not a new independent fact. If you removed `
+      + `the line before it, this line should stop making sense on its own -- that's how you know `
+      + `it's a real reply and not narrating the news. Ask the other host direct questions, push `
+      + `back on what they just claimed, ask "peraí, como assim?", finish their thought, or react `
+      + `specifically to a word they used. Never simply add a new fact next to the previous line -- `
+      + `engage with what was just said.\n`
+      + `Bad (two narrators): "[A] O Corinthians pega o Estudiantes quarta-feira." / "[B] O jogo `
+      + `é às 21h30 na Neo Química Arena." -- two separate facts, nobody is talking to anybody.\n`
+      + `Good (an actual reply): "[A] O Corinthians pega o Estudiantes quarta." / "[B] Quarta? Eu `
+      + `jurava que era semana que vem." / "[A] Não, é amanhã mesmo -- e olha que horário: 21h30." `
+      + `-- B reacts to A's specific claim (the day) before anything else happens.\n\n`
+      + `Vary line length: mix the occasional one-or-two-word reaction ("Não acredito.", "Espera.", `
+      + `"Sério mesmo?") with longer thoughts, and don't let two consecutive lines run the same `
+      + `length. A host may trail off or self-correct sometimes. Have them actually disagree, tease `
+      + `each other, or share a personal, slightly tangential opinion at least once -- not just `
+      + `build on ("yes, and") what the other said. A hedge or filler native to the target language `
+      + `("tipo", "sei lá") is fine sparingly, where a real person would actually pause.\n\n`
+      + `But casual is not the same as unclear, and this matters more than sounding relaxed: every `
+      + `single line must be something a listener can understand on ONE listen, with a complete, `
+      + `sensible thought. If a shorter or more fragmented version of a line would be even slightly `
+      + `confusing, ambiguous, or grammatically broken, write the clearer, more complete version `
+      + `instead -- clarity always wins over style. Never invent a slang term, idiom, or nickname `
+      + `to sound casual; only use expressions and nicknames you're confident a native speaker would `
+      + `actually recognize, and once you pick a nickname for a person, team, or place, keep using `
+      + `that exact same one for the rest of the episode -- never switch between two different `
+      + `nicknames for the same thing.\n\n`
+      + `Only state facts, dates, numbers, and details that are actually in the document below or `
+      + `were already said earlier in this conversation. Never invent a specific day, time, number, `
+      + `or claim to fill a line -- if you're not sure the document supports it, say something vaguer `
+      + `("em breve", "depois disso") instead of a specific-sounding invented detail.\n\n`
+      + `You may inline these paralinguistic tags where a real reaction would land -- sparingly, `
+      + `at most one per line, only where genuinely earned by the moment, and ONLY these exact `
+      + `strings, character for character -- never a variant or synonym: `
+      + `${NONVERBAL_TAGS.join(' ')}. They render as actual sounds, not spoken words. This means: `
+      + `never describe the sound in prose, AND never follow a tag with a spoken interjection that `
+      + `echoes it (the tag IS the reaction, so nothing after it should restate "Ah", "Oh", "Ei", `
+      + `"Wow", "Hmm" or similar in any language -- continue straight into the next real sentence). `
+      + `Bad: "[question-ei] Ei, sério?" -- Good: "[question-ei] Sério que ele fez isso?". `
+      + `Never write meta-commentary about the conversation itself (no "translating", "in other `
+      + `words", "resuming" or similar narrator asides) -- only the hosts' actual spoken lines.\n\n`
+      + `Write entirely in this language: ${language || 'the document\'s own language'}.\n\n`
+      + `You will be asked for one line at a time, always naming which host speaks next. Call `
+      + `write_turn with exactly that host's next line -- never write both hosts, never restate `
+      + `earlier lines, never plan ahead.\n\n`
+      + `DOCUMENT:\n${doc}`;
+  }
+
+  async function writeNextTurn(
+    history: ChatMessage[], speaker: 'A' | 'B', isFirst: boolean, isLast: boolean
+  ): Promise<{ text: string; history: ChatMessage[] }> {
+    const framing = isFirst
+      ? 'Open the episode with a hook that pulls the listener in.'
+      : isLast
+        ? 'This is the final line of the episode -- land on a clear, satisfying takeaway.'
+        : 'Reply directly to the specific thing that was just said.';
+    const nudge: ChatMessage = {
+      role: 'user',
+      content: `Now write Host ${speaker}'s next line. ${framing} Reminder: this line must make `
+        + `complete, immediate sense on one listen -- don't sacrifice clarity for a fragment or `
+        + `invented slang; don't state any date, number, or detail not already established; keep `
+        + `any nickname exactly as used before. At most one tag, written exactly as specified, `
+        + `never echoed as a spoken word right after it; no commentary about the conversation itself.`
+    };
+    const requestMessages = [...history, nudge];
+    const response = await chatComplete({
+      messages: requestMessages,
+      tools: [WRITE_TURN_TOOL],
+      tool_choice: 'required',
+      temperature: 1.05,
+      // Each round only needs to produce ONE short line, but the model still
+      // reasons at length before calling the tool -- same headroom logic as
+      // the single-shot version, just smaller since there's one line to plan
+      // instead of a whole episode.
+      max_tokens: 3000
+    });
+    const choice = response.choices[0];
+    const call = choice?.message?.tool_calls?.[0];
+    if (!call) {
+      throw new Error(choice?.finish_reason === 'length'
+        ? `The script model ran out of budget writing Host ${speaker}'s line.`
+        : `The script model did not produce a line for Host ${speaker}.`);
+    }
+    let text: string;
+    try {
+      text = (JSON.parse(call.function.arguments) as { text: string }).text;
+    } catch {
+      throw new Error(`The script model returned a malformed line for Host ${speaker}.`);
+    }
+    // Commit ONLY this one call, discarding any others the model volunteered
+    // in the same response -- the next round must see this exact text, not
+    // whatever else the model additionally planned in the same breath.
+    const committed: ChatMessage[] = [
+      ...requestMessages,
+      { role: 'assistant', tool_calls: [call] },
+      { role: 'tool', tool_call_id: call.id, content: 'ok' }
+    ];
+    return { text: sanitizeNonverbalTags(text), history: committed };
+  }
+
+  async function draftTitle(turns: Turn[]): Promise<string> {
+    const transcript = turns.map((t) => `${t.speaker}: ${t.text}`).join('\n');
+    const schema = {
+      type: 'object', properties: { title: { type: 'string' } },
+      required: ['title'], additionalProperties: false
+    };
+    const response = await chatComplete({
+      messages: [{
+        role: 'user',
+        content: `Give this podcast episode a punchy, specific 3-8 word title (no quotes, no `
+          + `episode numbers).\n\n${transcript}`
+      }],
+      max_tokens: 1000,
+      response_format: { type: 'json_schema', json_schema: { name: 'episode_title', strict: true, schema } }
+    });
+    const content = response.choices[0]?.message?.content;
+    if (!content) return 'Podcast episode';
+    try { return (JSON.parse(content) as { title: string }).title || 'Podcast episode'; }
+    catch { return 'Podcast episode'; }
+  }
