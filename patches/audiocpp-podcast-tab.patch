+  export async function generate() {
+    resetOutput();
+    aborted = false;
+    if (!docText.trim()) { errorText = 'Paste some text or upload a document first.'; return; }
+    try {
+      step = 'script';
+      const doc = docText.trim().slice(0, MAX_DOC_CHARS);
+      const truncatedNote = docText.trim().length > MAX_DOC_CHARS
+        ? '\n\n[document truncated to fit the context window]' : '';
+      let history: ChatMessage[] = [
+        { role: 'system', content: systemPrompt(doc + truncatedNote) }
+      ];
+      script = { title: '', turns: [] };
+      for (let i = 0; i < turnCount; i += 1) {
+        if (aborted) return;
+        const speaker: 'A' | 'B' = i % 2 === 0 ? 'A' : 'B';
+        statusText = `Writing line ${i + 1} of ${turnCount}…`;
+        const result = await writeNextTurn(history, speaker, i === 0, i === turnCount - 1);
+        history = result.history;
+        script.turns = [...script.turns, { speaker, text: result.text }];
+        turnStatuses = [...turnStatuses, 'queued'];
+      }
+      if (aborted) return;
+      statusText = 'Naming the episode…';
+      script.title = await draftTitle(script.turns);
+
+      step = 'voice';
+      const clips: Blob[] = [];
+      for (let i = 0; i < script.turns.length; i += 1) {
+        if (aborted) return;
+        turnProgress = i;
+        turnStatuses[i] = 'voicing';
+        statusText = `Voicing line ${i + 1} of ${script.turns.length}…`;
+        clips.push(await voiceTurn(script.turns[i]));
+        turnStatuses[i] = 'done';
+      }
+      turnProgress = script.turns.length;
