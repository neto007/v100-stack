#!/usr/bin/env bash
# Controle do stack V100. Nada sobe no boot: tudo sob demanda.
#
#   --web  expoe tambem a interface web, alem da API.
#          audio: 8080 = API balanceada nas 2 placas | 8088 = UI (presa a GPU0)
#          llm  : 8090 = API                         | 8091 = UI
set -euo pipefail
PREFIX=@PREFIX@
AUDIO=(audiocpp@0 audiocpp@1)
AUDIO_ENV=$PREFIX/deploy/audiocpp-gpu0.env  # so a GPU0 (atras de :8088) pode servir UI
LAN_IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}' || echo 127.0.0.1)

c(){ printf '\033[%sm%s\033[0m' "$1" "$2"; }
vram(){ nvidia-smi --query-gpu=index,memory.used,memory.total,utilization.gpu \
        --format=csv,noheader,nounits | awk -F', ' \
        '{printf "  GPU%s  %5d / %5d MiB  (%2d%%)\n",$1,$2,$3,$4}'; }
wait_health(){ for _ in $(seq 1 "${2:-60}"); do
    curl -sf --max-time 2 "$1" >/dev/null 2>&1 && return 0; sleep 1; done; return 1; }

WEB=0
ARGS=(); for a in "$@"; do [ "$a" = "--web" ] && WEB=1 || ARGS+=("$a"); done
set -- "${ARGS[@]:-status}"

case "${1:-status}" in
  audio)
    case "${2:-status}" in
      start)
        # A UI e um flag do proprio servidor, entao alterna-se o env e reinicia.
        want="--no-ui"; [ "$WEB" = 1 ] && want="--ui"
        if ! grep -q -- "AUDIO_UI_FLAG=$want" "$AUDIO_ENV" 2>/dev/null; then
          sudo sed -i "s|^AUDIO_UI_FLAG=.*|AUDIO_UI_FLAG=$want|" "$AUDIO_ENV"
          sudo systemctl restart "${AUDIO[@]}" 2>/dev/null || true
        fi
        sudo systemctl start "${AUDIO[@]}" nginx
        wait_health http://127.0.0.1:8080/health 60 || {
          echo "$(c 31 '[FALHA]') journalctl -u audiocpp@0 -n 30"; exit 1; }
        echo "$(c 32 '[OK]') audio API   http://$LAN_IP:8080   (balanceada nas 2 placas)"
        [ "$WEB" = 1 ] && echo "$(c 32 '[OK]') audio WebUI http://$LAN_IP:8088   (presa a GPU0 -- uploads sao por processo)"
        ;;
      stop) sudo systemctl stop "${AUDIO[@]}"; echo "audio parado" ;;
      logs) sudo journalctl -u audiocpp@0 -u audiocpp@1 -f ;;
      *)    systemctl is-active "${AUDIO[@]}" | tr '\n' ' '; echo ;;
    esac ;;
  llm)
    case "${2:-status}" in
      start)
        sudo systemctl start llamacpp
        echo "carregando o modelo (17,6 GiB + draft), leva ~1m30s..."
        wait_health http://127.0.0.1:8090/health 300 || {
          echo "$(c 31 '[FALHA]') journalctl -u llamacpp -n 30"; exit 1; }
        echo "$(c 32 '[OK]') llm API   http://127.0.0.1:8090"
        [ "$WEB" = 1 ] && { sudo systemctl start nginx
          echo "$(c 32 '[OK]') llm WebUI http://$LAN_IP:8091"; }
        ;;
      stop) sudo systemctl stop llamacpp; echo "llm parado" ;;
      logs) sudo journalctl -u llamacpp -f ;;
      *)    systemctl is-active llamacpp ;;
    esac ;;
  start) w=(); [ "$WEB" = 1 ] && w=(--web)
         "$0" llm start "${w[@]}"; "$0" audio start "${w[@]}" ;;
  stop)  sudo systemctl stop llamacpp "${AUDIO[@]}" 2>/dev/null || true; echo "tudo parado" ;;
  status)
    printf '%-10s %s\n' "llm"   "$(systemctl is-active llamacpp)"
    printf '%-10s %s\n' "audio" "$(systemctl is-active "${AUDIO[@]}" | tr '\n' ' ')"
    printf '%-10s %s\n' "nginx" "$(systemctl is-active nginx)"
    printf '%-10s %s\n' "ui audio" "$(sed -n 's/^AUDIO_UI_FLAG=//p' "$AUDIO_ENV" 2>/dev/null || echo '?')"
    echo; vram ;;
  *)
    cat <<USAGE
v100ctl -- controle do stack V100 (nada sobe no boot)

  v100ctl status                    servicos e VRAM
  v100ctl start [--web]             tudo
  v100ctl stop
  v100ctl llm   start [--web] | stop | logs | status
  v100ctl audio start [--web] | stop | logs | status

Com --web:
  audio  8080 API balanceada nas 2 placas | 8088 WebUI (GPU0)
  llm    8090 API                         | 8091 WebUI

A WebUI do audio fica presa a UMA placa de proposito: o diretorio de upload do
audiocpp e criado por processo, entao subir um audio numa placa e sintetizar na
outra quebraria clonagem de voz e transcricao. A porta 8080 segue balanceada.

VRAM: 31,5 GiB no total.
  llm (27B + draft MTP) ~19,3 GiB | audio 0 ocioso, ~1,9 GiB/placa em uso
USAGE
    ;;
esac
